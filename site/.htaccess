# Specline — the public site.
#
# Hostinger deploys the repository into public_html, so the REPOSITORY ROOT is the
# web root and this directory is served at the domain root by the rules in the root
# .htaccess. That file handles the canonical host, HTTPS, and shutting the rest of
# the repository off. This file covers only what is local to the site.
#
# Nothing here is uploaded by hand. A manual upload is wiped by the next deployment.

Options -Indexes
# index.php as well as index.html: /account/ and /admin/ are PHP applications.
DirectoryIndex index.html index.php

# The waiting list writes ../specline-waitlist.csv, one directory above this one and
# therefore never web-served. This is only for the case where it is moved by mistake.
<FilesMatch "^specline-waitlist\.csv$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
